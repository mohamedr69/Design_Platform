+            assert all(d["status"] in ("COMPLETE", "INCOMPLETE", "DEFERRED") for d in docs.values())
+        for lane in ("B", "C", "R"):
+            p = folder / f"inv-{inv['n']}" / "out" / f"lane-{lane}.r32.json"

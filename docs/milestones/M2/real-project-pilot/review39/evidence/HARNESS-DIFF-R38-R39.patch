+
+
+class Page:
+    def get_text(self):
+        return ""
+
+
+class Pdf:
+    def __init__(self, n):
+        self.page_count = n
+
+    def __getitem__(self, i):
+        return Page()
+
+
+def scenario(calls_per_page, pages=4):
+    prov = Prov()

+
+
+def test_two_different_context_entries_with_one_order_are_ambiguous():
+    ai = add(r10, None, 1, [own("identity", "X-SD-1"), own("revision", "02")])
+    ai = add(r10, ai, 2, [own("identity", "X-SD-9")])

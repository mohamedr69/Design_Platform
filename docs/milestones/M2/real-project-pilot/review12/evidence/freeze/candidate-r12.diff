+    s = score(ai, reference="X-SD-9", revision="02")
+    assert ("02", "validated", "correct") not in s.judged("revision") and s.recovery["revision"] != "recovered_clean"
+    assert assoc(ai, "own:revision").get("status") == "held:context_unavailable"

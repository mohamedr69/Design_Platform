+                              {"ai_ms": round(form_seconds * 1000, 1)}, ai=True)
+        except BaseException:
+            # Stopped (cancelled, or the worker shutting down): the forms
+            # the model has not read go back to pending, not left mid-read.
+            db.rollback()

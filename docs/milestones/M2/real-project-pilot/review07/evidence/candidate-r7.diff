+def _render_page(page: pymupdf.Page, dpi: int = RENDER_DPI) -> Image.Image:
+    pix = page.get_pixmap(dpi=dpi)
+    mode = "RGB" if pix.n >= 3 else "L"
+    return Image.frombytes(mode, (pix.width, pix.height), pix.samples).convert("L")

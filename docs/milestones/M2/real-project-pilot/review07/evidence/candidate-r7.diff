+    failed = {"attempt": 2, "outcome": "failed", "coverage": {"pages": []}, "observations": []}
+    ai = er.merge_evidence(ai, failed, sha256="s2", profile="default", variant="EV1")
+    assert er.current_evidence(ai) == {} or er.current_evidence(ai)["read_sha256"] == "s2"

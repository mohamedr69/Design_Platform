+def _detect_line_positions(dark_fraction: np.ndarray, min_frac: float) -> list[int]:
+    positions = [i for i, frac in enumerate(dark_fraction) if frac > min_frac]
+    lines: list[int] = []
+    prev = -10
+    for pos in positions:
+        if pos - prev > 3:
+            lines.append(pos)
+        prev = pos
+    return lines

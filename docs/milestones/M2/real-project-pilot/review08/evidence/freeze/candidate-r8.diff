+def _scripted_run(answers):
+    answers = list(answers)
+    log = []
+
+    def call(**kw):
+        a = answers.pop(0)
+        log.append({"outcome": "ok" if a is not None else "timeout"})
+        return a
+    return {"call": call, "variant": "EV1", "profile": "default", "escalations": 0, "exhausted": None, "log": log}

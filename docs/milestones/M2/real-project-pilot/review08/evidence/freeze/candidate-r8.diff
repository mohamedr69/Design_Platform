+    assert value(ai, "own:decision")[:3] == ("ANN", "validated", 1), "the refused read replaces nothing"
+    assert value(ai, "own:identity")[0] == "X-SD-9" and value(ai, "own:identity")[2] == 2, "the completed read replaces"

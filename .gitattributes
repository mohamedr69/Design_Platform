# Windows batch files need CRLF line endings to run reliably on any PC.
*.bat text eol=crlf

# Milestone 2's evidence is bound to sha256 hashes of the files exactly as written: never convert their line endings.
docs/milestones/M2/** -text

# Milestone 5's evidence is bound to sha256 hashes of the files exactly as written (U2M5-05): never convert their line endings.
docs/milestones/M5/** -text
